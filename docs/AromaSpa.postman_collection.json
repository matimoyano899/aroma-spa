{
  "info": {
    "name": "Aroma Spa · Agenda de turnos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Elegí el entorno con baseUrl. Completá las credenciales de prueba y una fecha futura habilitada en formato AAAA-MM-DD. Ejecutá las solicitudes en orden. Después del registro, copiá el token del enlace del buzón en verificationToken antes de confirmar. Archivá el servicio desde Limpieza cuando terminen las pruebas. Borrá contraseñas y tokens antes de compartir la colección."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "clientEmail",
      "value": "cliente@example.test",
      "type": "string"
    },
    {
      "key": "clientPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "verificationToken",
      "value": "",
      "type": "string"
    },
