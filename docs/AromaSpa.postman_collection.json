    {
      "name": "Turnos",
      "item": [
        {
          "name": "Ver agenda sin JWT",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/appointments",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('HTTP 401', () => pm.response.to.have.status(401));"]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Horarios disponibles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/appointments/availability?serviceId={{serviceId}}&date={{date}}",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{clientToken}}",
                "type": "text"
              }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const slots = pm.response.json().data || [];",
                  "pm.test('Hay dos inicios alternativos', () => pm.expect(slots.length).to.be.at.least(3));",
                  "if (slots.length >= 3) { pm.collectionVariables.set('startAt', slots[0]); pm.collectionVariables.set('newStartAt', slots[2]); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Reservar",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/appointments",
            "header": [
              {
                "key": "Content-Type",
